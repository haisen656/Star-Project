# Public client values (web and mobile)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=https://quickdrop.example.com

# Supabase Edge Function secrets. Set with: supabase secrets set NAME=value
# Never place these in a client-side environment file.
PAIRING_HASH_SECRET=replace-with-a-long-random-secret
MAX_FILE_BYTES=2147483648
MAX_SPACE_BYTES=2147483648
WEB_APP_URL=https://quickdrop.example.com
CRON_SECRET=replace-with-another-long-random-secret
